# --- 2N device --------------------------------------------------------------
TWON_HOST=192.0.2.10              # hostname or IP of the 2N device
TWON_SCHEME=https                 # http sends the credentials in the clear
TWON_USER=2n2mqtt                 # dedicated API account, read-only
TWON_PASS=changeme
TWON_VERIFY_SSL=false             # 2N ships a self-signed certificate
TWON_TIMEOUT=8

# --- Polling ----------------------------------------------------------------
IO_POLL_INTERVAL=60               # seconds; values below 30 are clamped to 30
LOG_LONG_POLL_TIMEOUT=30          # blocking /api/log/pull; 0 disables long-polling
LOG_POLL_INTERVAL=3               # interval used when long-polling is disabled
# Comma-separated event types. A subscription with no filter covers nothing, so
# leaving this empty uses a built-in default list. GET /api/log/caps lists what
# your firmware actually supports.
LOG_FILTER=
ACCESS_GRANTED_EVENTS=UserAuthenticated,AccessTaken
ACCESS_DENIED_EVENTS=UserRejected,AccessDenied,UnauthorizedDoorOpen

# --- Features ---------------------------------------------------------------
ENABLE_IO=true
ENABLE_ACCESS_LOG=true
ENABLE_DISCOVERY=true

# --- I/O ports --------------------------------------------------------------
# Real identifiers come from GET /api/io/caps and depend on model and wiring.
# A mapped port is also published under its role name (io/tamper, io/door), so
# consumers do not have to know how this device names its inputs.
# Leave all three empty to publish every port the device reports.
IO_PORT_TAMPER=
IO_PORT_DOOR=
IO_PORTS_EXTRA=

# --- Privacy ----------------------------------------------------------------
# Access events carry the name of a real person. Set to false to publish a
# stable opaque id instead.
PUBLISH_USER_NAMES=true

# --- MQTT -------------------------------------------------------------------
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=2n2mqtt
MQTT_PASS=changeme
MQTT_CLIENT_ID=2n2mqtt
STATE_PREFIX=2n/2n_access_unit    # root of every state topic
DISCOVERY_PREFIX=homeassistant

# --- Device identity (Home Assistant discovery) -----------------------------
DEVICE_ID=2n_access_unit
DEVICE_NAME=2N Access Unit
DEVICE_MANUFACTURER=2N
DEVICE_MODEL=                     # auto-detected from /api/system/info when empty
SUGGESTED_AREA=

# --- Docker networking (only read by docker-compose.override.yml) -----------
DEVICE_NET_NAME=
BROKER_NET_NAME=
BRIDGE_IPV4=
BRIDGE_IPV6=
